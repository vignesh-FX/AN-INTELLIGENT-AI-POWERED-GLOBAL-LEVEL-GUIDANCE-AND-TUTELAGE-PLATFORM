# ── Database ───────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → "URI". Use the *database password*
# (NOT the anon / service-role API keys — the backend talks to Postgres directly).
# Pooler (port 6543, transaction mode) is recommended for hosted deployments.
# Leave empty to use a local SQLite file for quick development.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
RATE_LIMIT_ENABLED=true

# ── Question routing (TF-IDF + cosine) — all optional tuning ───────────────────
# ROUTING_TOP_K=10
# ROUTING_MIN_SIMILARITY=0.05
# FEED_WEIGHTS={"similarity":0.5,"field":0.12,"tag":0.14,"community":0.08,"recency":0.10,"activity":0.06}
# QUALITY_WEIGHTS={"rating":0.4,"helpful":0.2,"accepted":0.2,"votes":0.1,"volume":0.1}

# ── Translation (needs requirements-ml.txt) ────────────────────────────────────
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TRANSLATION_DEVICE=auto
